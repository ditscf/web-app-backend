# This file is gitignored.

# server
PORT=8000

# NestJS
OBSERVE_APP_KEY=sample-app-key
OBSERVE_APP_SECRET=sample-app-secret
OBSERVE_SERVICE_ID=replace-with-your-service-id

# Frontend Origin
FRONTEND_ORIGIN=http://localhost:3000

# Session Auth
AUTH_CODE_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=3600
LOGIN_CODE_TTL_SECONDS=600
MAX_LOGIN_CODES_PER_HOUR=5
MAX_CODE_ATTEMPTS=5
COOKIE_NAME=replace-with-your-cookie-name
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
TRUST_PROXY=false

# Resend
RESEND_API_KEY=replace-with-your-resend-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ditscf